#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF INT_MAX

// Structure to represent a weighted edge in the graph
typedef struct {
    int u, v, w;
} Edge;

// Function to print the path recursively using parent pointers
void printPath(int parent[], int vertex) {
    if (parent[vertex] == -1) {
        printf("%d", vertex);
        return;
    }
    printPath(parent, parent[vertex]);
    printf("->%d", vertex);
}

int main() {
    int V, E;
    if (scanf("%d %d", &V, &E) != 2) return 0;

    Edge* edges = (Edge*)malloc(E * sizeof(Edge));
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    int src;
    scanf("%d", &src);

    // Dynamic arrays for distances and parent tracking (1-indexed, size V + 1)
    long long* dist = (long long*)malloc((V + 1) * sizeof(long long));
    int* parent = (int*)malloc((V + 1) * sizeof(int));

    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[src] = 0;

    // Relax all edges V - 1 times
    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }

    // Check for negative-weight cycles
    int hasNegativeCycle = 0;
    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            hasNegativeCycle = 1;
            break;
        }
    }

    if (hasNegativeCycle) {
        printf("Negative cycle detected\n");
    } else {
        // Print results for all vertices 1 to V (except the source)
        for (int i = 1; i <= V; i++) {
            if (i == src) continue;

            if (dist[i] == INF) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %lld ", i, dist[i]);
                printPath(parent, i);
                printf("\n");
            }
        }
    }

    // Free dynamically allocated memory
    free(edges);
    free(dist);
    free(parent);

    return 0;
}

