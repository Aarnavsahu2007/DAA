#include <stdio.h>
#include <stdlib.h>

int main() {
    int r1, c1;
    // Read dimensions of Matrix A
    if (scanf("%d %d", &r1, &c1) != 2) return 0;

    // Allocate and read Matrix A
    int A[r1][c1];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            if (scanf("%d", &A[i][j]) != 1) return 0;
        }
    }

    int r2, c2;
    // Read dimensions of Matrix B
    if (scanf("%d %d", &r2, &c2) != 2) return 0;

    // Check multiplication compatibility immediately
    if (c1 != r2) {
        printf("Invalid input\n");
        return 0;
    }

    // Since compatibility passes, safely read Matrix B
    int B[r2][c2];
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            if (scanf("%d", &B[i][j]) != 1) return 0;
        }
    }

    // Initialize the product matrix with zeros
    int C[r1][c2];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            C[i][j] = 0;
        }
    }

    // Perform Matrix Multiplication
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Print the result matrix with a trailing space on each number
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
 
